#!/usr/bin/env bash
#
# wp-safe-update: Resilient WordPress & WooCommerce Plugin Update Runner
# Performs pre-flight checks, full DB + plugin backups, staged updates,
# HTTP smoke tests on critical routes, and automated rollback upon failure.
#

set -o pipefail

# ANSI color codes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# Script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Default configurations
WP_PATH="${WP_PATH:-.}"
PLUGINS="--all"
SITE_URL="${SITE_URL:-}"
ROUTES="/,/shop/,/cart/,/checkout/,/wp-login.php"
BACKUP_DIR="${BACKUP_DIR:-}"
DRY_RUN=0
MOCK_MODE=0
MOCK_FAIL=0
SKIP_BACKUP=0
SKIP_SMOKE=0
TIMEOUT=10
VERBOSE=0

log_info() {
    echo -e "${CYAN}[INFO]${NC} $*"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $*"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $*"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $*" >&2
}

log_step() {
    echo -e "\n${BOLD}${BLUE}==>${NC} ${BOLD}$*${NC}"
}

usage() {
    cat <<EOF
Usage: wp-safe-update [options]

Automated, resilient WordPress & WooCommerce plugin update runner with
pre-update backups, WP-CLI execution, HTTP smoke tests, and automated rollback.

Options:
  -p, --path=<path>         Path to WordPress root directory (default: current directory)
      --plugins=<list>      Specific plugins to update (comma-separated or name, default: --all)
  -u, --url=<url>           Base site URL for smoke testing (default: detected from wp-cli)
  -r, --routes=<routes>     Comma-separated routes to test (default: /,/shop/,/cart/,/checkout/,/wp-login.php)
  -b, --backup-dir=<dir>    Directory to store pre-update backups (default: <path>/wp-content/uploads/wp-safe-backups)
  -t, --timeout=<sec>       HTTP timeout in seconds for smoke tests (default: 10)
      --dry-run             Simulate updates without applying changes or modifying files
      --mock                Run in mock mode (simulates WP-CLI & smoke tests for verification)
      --mock-fail           Run in mock mode simulating smoke test failure to verify rollback
      --skip-backup         Skip pre-update database and file backup
      --skip-smoke          Skip HTTP smoke testing after update
  -v, --verbose             Enable verbose logging output
  -h, --help                Show this help message and exit

Environment Variables:
  WP_PATH                   Default WordPress directory path
  SITE_URL                  Default base site URL
  BACKUP_DIR                Default backup directory
  WP_SAFE_UPDATE_MOCK       Set to 1 to enable mock mode
  WP_SAFE_UPDATE_MOCK_FAIL  Set to 1 to enable mock failure mode

Examples:
  wp-safe-update --path=/var/www/html --all
  wp-safe-update --path=/var/www/html --plugins=woocommerce,woocommerce-gateway-stripe
  wp-safe-update --dry-run
  wp-safe-update --mock
  wp-safe-update --mock --mock-fail
EOF
    exit 0
}

# Parse CLI arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            ;;
        -p|--path)
            WP_PATH="$2"
            shift 2
            ;;
        --path=*)
            WP_PATH="${1#*=}"
            shift
            ;;
        --plugins)
            PLUGINS="$2"
            shift 2
            ;;
        --plugins=*)
            PLUGINS="${1#*=}"
            shift
            ;;
        --all)
            PLUGINS="--all"
            shift
            ;;
        -u|--url)
            SITE_URL="$2"
            shift 2
            ;;
        --url=*)
            SITE_URL="${1#*=}"
            shift
            ;;
        -r|--routes)
            ROUTES="$2"
            shift 2
            ;;
        --routes=*)
            ROUTES="${1#*=}"
            shift
            ;;
        -b|--backup-dir)
            BACKUP_DIR="$2"
            shift 2
            ;;
        --backup-dir=*)
            BACKUP_DIR="${1#*=}"
            shift
            ;;
        -t|--timeout)
            TIMEOUT="$2"
            shift 2
            ;;
        --timeout=*)
            TIMEOUT="${1#*=}"
            shift
            ;;
        --dry-run)
            DRY_RUN=1
            shift
            ;;
        --mock)
            MOCK_MODE=1
            shift
            ;;
        --mock-fail)
            MOCK_MODE=1
            MOCK_FAIL=1
            shift
            ;;
        --skip-backup)
            SKIP_BACKUP=1
            shift
            ;;
        --skip-smoke)
            SKIP_SMOKE=1
            shift
            ;;
        -v|--verbose)
            VERBOSE=1
            shift
            ;;
        *)
            log_error "Unknown option: $1"
            usage
            ;;
    esac
done

# Check environment variable overrides
if [[ "${WP_SAFE_UPDATE_MOCK:-0}" == "1" ]]; then
    MOCK_MODE=1
fi
if [[ "${WP_SAFE_UPDATE_MOCK_FAIL:-0}" == "1" ]]; then
    MOCK_MODE=1
    MOCK_FAIL=1
fi

# Convert WP_PATH to absolute path
WP_PATH="$(cd "$WP_PATH" 2>/dev/null && pwd || echo "$WP_PATH")"

# Set default backup directory if not explicitly provided
if [[ -z "$BACKUP_DIR" ]]; then
    if [[ -d "$WP_PATH/wp-content/uploads" ]]; then
        BACKUP_DIR="$WP_PATH/wp-content/uploads/wp-safe-backups"
    else
        BACKUP_DIR="/tmp/wp-safe-backups"
    fi
fi

# State variables for rollback
CURRENT_BACKUP_PATH=""
PLUGINS_BACKUP_FILE=""
DB_BACKUP_FILE=""
UPDATE_ATTEMPTED=0

# Rollback function
perform_rollback() {
    local reason="$1"
    echo ""
    log_error "========================================================"
    log_error "CRITICAL FAILURE DETECTED: $reason"
    log_error "INITIATING AUTOMATED ROLLBACK"
    log_error "========================================================"

    if [[ "$SKIP_BACKUP" -eq 1 ]]; then
        log_error "Rollback impossible: Pre-update backup was skipped (--skip-backup)."
        exit 1
    fi

    if [[ -z "$CURRENT_BACKUP_PATH" || ! -d "$CURRENT_BACKUP_PATH" ]]; then
        log_error "Rollback failed: Backup directory not found ($CURRENT_BACKUP_PATH)."
        exit 1
    fi

    local rollback_ok=1

    # 1. Restore plugins directory
    if [[ -f "$PLUGINS_BACKUP_FILE" ]]; then
        log_info "Restoring plugins directory from archive: $PLUGINS_BACKUP_FILE..."
        local plugins_dir="$WP_PATH/wp-content/plugins"
        if [[ -d "$plugins_dir" ]]; then
            find "$plugins_dir" -mindepth 1 -delete 2>/dev/null || true
        fi
        mkdir -p "$plugins_dir"

        if tar -xzf "$PLUGINS_BACKUP_FILE" -C "$WP_PATH/wp-content"; then
            log_success "Plugins directory restored successfully."
        else
            log_error "Failed to extract plugins archive during rollback!"
            rollback_ok=0
        fi
    else
        log_warn "Plugins backup file not found ($PLUGINS_BACKUP_FILE), skipping file restore."
    fi

    # 2. Restore database
    if [[ -f "$DB_BACKUP_FILE" ]]; then
        log_info "Restoring database from export: $DB_BACKUP_FILE..."
        if [[ "$MOCK_MODE" -eq 1 ]]; then
            log_info "[MOCK] wp db import $DB_BACKUP_FILE (simulated)"
            log_success "Database restored successfully (mock)."
        else
            if wp db import "$DB_BACKUP_FILE" --path="$WP_PATH" >/dev/null 2>&1; then
                log_success "Database restored successfully."
            else
                log_error "Database import failed during rollback!"
                rollback_ok=0
            fi
        fi
    else
        log_warn "Database backup file not found ($DB_BACKUP_FILE), skipping DB restore."
    fi

    # 3. Post-rollback notification
    if [[ "$rollback_ok" -eq 1 ]]; then
        log_success "========================================================"
        log_success "ROLLBACK COMPLETED: System returned to pre-update state."
        log_success "Backup preserved at: $CURRENT_BACKUP_PATH"
        log_success "========================================================"
    else
        log_error "ROLLBACK FINISHED WITH ERRORS. Manual intervention required."
    fi

    exit 1
}

# ==============================================================================
# PHASE 1: PRE-FLIGHT CHECKS
# ==============================================================================
log_step "PHASE 1: PRE-FLIGHT CHECKS"
log_info "Target WordPress Path: $WP_PATH"
log_info "Target Plugins: $PLUGINS"
log_info "Execution Mode: $([[ "$MOCK_MODE" -eq 1 ]] && echo "MOCK" || echo "LIVE")$([[ "$DRY_RUN" -eq 1 ]] && echo " (DRY-RUN)" || echo "")"

if [[ "$MOCK_MODE" -eq 1 ]]; then
    log_info "Running in MOCK mode — validating mock environment..."
    if [[ ! -d "$WP_PATH" ]]; then
        mkdir -p "$WP_PATH/wp-content/plugins/woocommerce"
        cat <<'PHP' > "$WP_PATH/wp-content/plugins/woocommerce/woocommerce.php"
<?php
/**
 * Plugin Name: WooCommerce
 * Version: 8.0.0
 */
PHP
        echo "8.0.0" > "$WP_PATH/wp-content/plugins/woocommerce/version.txt"
    fi
    log_success "Pre-flight checks passed (mock mode)."
else
    # Check for wp binary
    if ! command -v wp >/dev/null 2>&1; then
        log_error "WP-CLI ('wp') command not found in PATH. Please install WP-CLI or use --mock."
        exit 1
    fi

    # Check WP path
    if [[ ! -d "$WP_PATH" ]]; then
        log_error "WordPress directory '$WP_PATH' does not exist."
        exit 1
    fi

    # Verify WP core is installed
    if ! wp core is-installed --path="$WP_PATH" >/dev/null 2>&1; then
        log_error "WordPress core is not installed or invalid configuration at '$WP_PATH'."
        exit 1
    fi

    # Verify DB connectivity
    if ! wp db check --path="$WP_PATH" >/dev/null 2>&1; then
        log_error "Database connection failed or tables corrupted at '$WP_PATH'."
        exit 1
    fi

    # Auto-detect site URL if not provided
    if [[ -z "$SITE_URL" ]]; then
        SITE_URL="$(wp option get siteurl --path="$WP_PATH" 2>/dev/null || echo "")"
        if [[ -n "$SITE_URL" ]]; then
            log_info "Auto-detected Site URL: $SITE_URL"
        fi
    fi

    log_success "Pre-flight checks passed: WP-CLI, Core installation, and DB connection verified."
fi

# Fallback default for SITE_URL
if [[ -z "$SITE_URL" ]]; then
    SITE_URL="http://localhost:8080"
fi

# ==============================================================================
# PHASE 2: PRE-UPDATE BACKUP
# ==============================================================================
log_step "PHASE 2: PRE-UPDATE BACKUP"

if [[ "$SKIP_BACKUP" -eq 1 ]]; then
    log_warn "Pre-update backup skipped due to --skip-backup flag."
elif [[ "$DRY_RUN" -eq 1 ]]; then
    log_info "[DRY-RUN] Would create backup in $BACKUP_DIR/backup_<timestamp>"
else
    TIMESTAMP="$(date +"%Y%m%d_%H%M%S")"
    CURRENT_BACKUP_PATH="${BACKUP_DIR}/backup_${TIMESTAMP}"
    mkdir -p "$CURRENT_BACKUP_PATH" || {
        log_error "Failed to create backup directory '$CURRENT_BACKUP_PATH'."
        exit 1
    }

    PLUGINS_BACKUP_FILE="${CURRENT_BACKUP_PATH}/plugins.tar.gz"
    DB_BACKUP_FILE="${CURRENT_BACKUP_PATH}/db.sql"
    MANIFEST_FILE="${CURRENT_BACKUP_PATH}/pre-update-plugins.json"

    # 1. Archive plugins directory
    log_info "Archiving plugins directory to: $PLUGINS_BACKUP_FILE..."
    if [[ -d "$WP_PATH/wp-content/plugins" ]]; then
        if tar -czf "$PLUGINS_BACKUP_FILE" -C "$WP_PATH/wp-content" plugins; then
            local_size=$(du -sh "$PLUGINS_BACKUP_FILE" 2>/dev/null | awk '{print $1}')
            log_success "Plugins archive created (${local_size:-OK})."
        else
            log_error "Failed to create plugins archive."
            exit 1
        fi
    else
        log_warn "No wp-content/plugins directory found at '$WP_PATH'."
    fi

    # 2. Database Export
    log_info "Exporting database to: $DB_BACKUP_FILE..."
    if [[ "$MOCK_MODE" -eq 1 ]]; then
        cat <<'SQL' > "$DB_BACKUP_FILE"
-- wp-safe-update mock database export
-- Dump completed
SQL
        log_success "Database export created (mock)."
    else
        if wp db export "$DB_BACKUP_FILE" --path="$WP_PATH" --quick >/dev/null 2>&1; then
            db_size=$(du -sh "$DB_BACKUP_FILE" 2>/dev/null | awk '{print $1}')
            log_success "Database export completed (${db_size:-OK})."
        else
            log_error "Database export failed."
            exit 1
        fi
    fi

    # 3. Snapshot active plugins manifest
    if [[ "$MOCK_MODE" -eq 1 ]]; then
        cat <<'JSON' > "$MANIFEST_FILE"
[
  {"name": "woocommerce", "status": "active", "update": "available", "version": "8.0.0", "update_version": "8.1.0"}
]
JSON
    else
        wp plugin list --format=json --path="$WP_PATH" > "$MANIFEST_FILE" 2>/dev/null || true
    fi

    log_success "Backup completed successfully at $CURRENT_BACKUP_PATH"
fi

# ==============================================================================
# PHASE 3: STAGED PLUGIN UPDATE
# ==============================================================================
log_step "PHASE 3: STAGED PLUGIN UPDATE"

if [[ "$DRY_RUN" -eq 1 ]]; then
    log_info "[DRY-RUN] Simulating plugin update..."
    if [[ "$MOCK_MODE" -eq 1 ]]; then
        log_info "[DRY-RUN] [MOCK] Would update: woocommerce (8.0.0 -> 8.1.0)"
    else
        wp plugin update --dry-run $PLUGINS --path="$WP_PATH"
    fi
    log_success "[DRY-RUN] Update simulation complete. Exiting without making changes."
    exit 0
fi

UPDATE_ATTEMPTED=1

if [[ "$MOCK_MODE" -eq 1 ]]; then
    log_info "[MOCK] Updating plugins: $PLUGINS..."
    # Simulate an actual file modification in the plugins dir
    if [[ -d "$WP_PATH/wp-content/plugins/woocommerce" ]]; then
        echo "8.1.0" > "$WP_PATH/wp-content/plugins/woocommerce/version.txt"
        cat <<'PHP' > "$WP_PATH/wp-content/plugins/woocommerce/woocommerce.php"
<?php
/**
 * Plugin Name: WooCommerce
 * Version: 8.1.0
 */
PHP
    fi
    log_success "[MOCK] Plugin update finished successfully."
else
    log_info "Executing WP-CLI plugin update ($PLUGINS)..."
    local_update_cmd=(wp plugin update)
    if [[ "$PLUGINS" == "--all" ]]; then
        local_update_cmd+=(--all)
    else
        # Split comma-separated plugins into arguments
        IFS=',' read -ra ADDR <<< "$PLUGINS"
        for p in "${ADDR[@]}"; do
            local_update_cmd+=("$p")
        done
    fi
    local_update_cmd+=(--path="$WP_PATH")

    if ! "${local_update_cmd[@]}"; then
        perform_rollback "WP-CLI plugin update command returned non-zero exit status."
    fi
    log_success "WP-CLI plugin update command executed successfully."
fi

# ==============================================================================
# PHASE 4: HTTP SMOKE TESTING
# ==============================================================================
log_step "PHASE 4: HTTP SMOKE TESTING"

if [[ "$SKIP_SMOKE" -eq 1 ]]; then
    log_warn "HTTP smoke testing skipped due to --skip-smoke flag."
else
    log_info "Target URL: $SITE_URL"
    log_info "Testing critical routes: $ROUTES"

    SMOKE_PASSED=1
    SMOKE_HELPER="$PROJECT_ROOT/src/smoke-test.ts"

    # Prefer running TypeScript helper via Bun or Node if available
    if command -v bun >/dev/null 2>&1 && [[ -f "$SMOKE_HELPER" ]]; then
        log_info "Running TypeScript smoke test runner via Bun..."
        SMOKE_CMD=(bun run "$SMOKE_HELPER" --url="$SITE_URL" --routes="$ROUTES" --timeout="$TIMEOUT")
        if [[ "$MOCK_MODE" -eq 1 ]]; then
            SMOKE_CMD+=(--mock)
        fi
        if [[ "$MOCK_FAIL" -eq 1 ]]; then
            SMOKE_CMD+=(--mock-fail)
        fi

        if ! "${SMOKE_CMD[@]}"; then
            SMOKE_PASSED=0
        fi
    else
        # Built-in Bash Curl smoke test fallback
        log_info "Running built-in cURL smoke test fallback..."
        IFS=',' read -ra ROUTE_ARR <<< "$ROUTES"

        FATAL_PATTERNS="Fatal error|Parse error|critical error on this website|wp-die-message|Call to undefined function|Uncaught Error|500 Internal Server Error"

        for route in "${ROUTE_ARR[@]}"; do
            route="$(echo "$route" | xargs)" # trim whitespace
            target_route_url="${SITE_URL%/}/${route#/}"
            
            if [[ "$MOCK_MODE" -eq 1 ]]; then
                if [[ "$MOCK_FAIL" -eq 1 && "$route" == *checkout* ]]; then
                    log_error "  ✖ [FAIL] $route - HTTP 500 (Simulated fatal error: Call to undefined function)"
                    SMOKE_PASSED=0
                    break
                else
                    log_info "  ✔ [PASS] $route (HTTP 200)"
                fi
            else
                temp_resp=$(mktemp)
                http_code=$(curl -s -L -o "$temp_resp" -w "%{http_code}" --max-time "$TIMEOUT" -A "WPSafeUpdateRunner/1.0" "$target_route_url" || echo "000")

                if [[ "$http_code" -ge 400 && "$http_code" -ne 401 && "$http_code" -ne 403 ]]; then
                    log_error "  ✖ [FAIL] $route - HTTP status $http_code"
                    rm -f "$temp_resp"
                    SMOKE_PASSED=0
                    break
                elif grep -Eiq "$FATAL_PATTERNS" "$temp_resp"; then
                    matched_pattern=$(grep -Eio "$FATAL_PATTERNS" "$temp_resp" | head -n 1)
                    log_error "  ✖ [FAIL] $route - Fatal error detected: '$matched_pattern'"
                    rm -f "$temp_resp"
                    SMOKE_PASSED=0
                    break
                else
                    log_info "  ✔ [PASS] $route (HTTP $http_code)"
                fi
                rm -f "$temp_resp"
            fi
        done
    fi

    if [[ "$SMOKE_PASSED" -eq 0 ]]; then
        perform_rollback "HTTP smoke tests failed post-update."
    fi

    log_success "All HTTP smoke tests passed with HTTP 200 and zero fatal errors."
fi

# ==============================================================================
# PHASE 5: SUMMARY & COMPLETION
# ==============================================================================
log_step "PHASE 5: COMPLETION"
echo ""
log_success "========================================================"
log_success "WP-SAFE-UPDATE COMPLETED SUCCESSFULLY"
log_success "Plugins updated safely."
if [[ -n "$CURRENT_BACKUP_PATH" ]]; then
    log_success "Pre-update backup saved at: $CURRENT_BACKUP_PATH"
fi
log_success "All critical routes smoke-tested and operational."
log_success "========================================================"

exit 0
